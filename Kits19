@patch
def windowed(self:Tensor, w, l):
    px = self.clone()
    px_min= l - w//2
    px_max= l + w//2
    px[px<px_min] = px_min
    px[px>px_max] = px_max
    return (px-px_min)/(px_max-px_min)

