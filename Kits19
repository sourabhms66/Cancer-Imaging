# Create lists to store file pairs
file_list_input = []
segmented_file = []

# Iterate through the dataset directory
for dirname, _, filenames in os.walk('data'):
    # Filter imaging files
    imaging_files = [filename for filename in filenames if 'imaging' in filename]

    # Iterate through imaging files
    for imaging_file in imaging_files:
        # Generate the corresponding segmentation filename
        segmentation_file = imaging_file.replace('imaging', 'segmentation')

        # Check if the segmentation file exists
        if segmentation_file in filenames:
            file_list_input.append((dirname, imaging_file))
            segmented_file.append((dirname, segmentation_file))

# Create dataframes
df_files_imaging = pd.DataFrame(file_list_input, columns=['dirname_input', 'filename'])
df_files_segmentation = pd.DataFrame(segmented_file, columns=['dirname_segmentation', 'filename_seg'])

